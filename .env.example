# Blotato API Configuration
BLOTATO_API_KEY=your_blotato_api_key_here
BLOTATO_API_BASE_URL=https://backend.blotato.com/v2

# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Logging Configuration
LOG_LEVEL=INFO

# OpenAI (required by the AI content and Skool content services)
OPENAI_API_KEY=your_openai_api_key_here

# Apify (optional; needed for requests with a youtube_url)
APIFY_API_TOKEN=your_apify_token_here

# Platform Account IDs (from Blotato dashboard)
# Replace with your actual account IDs after connecting accounts in Blotato
TIKTOK_ACCOUNT_ID=13354
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
FACEBOOK_ACCOUNT_ID=your_facebook_account_id
YOUTUBE_ACCOUNT_ID=your_youtube_account_id
LINKEDIN_ACCOUNT_ID=your_linkedin_account_id
TWITTER_ACCOUNT_ID=your_twitter_account_id
THREADS_ACCOUNT_ID=your_threads_account_id
BLUESKY_ACCOUNT_ID=your_bluesky_account_id
PINTEREST_ACCOUNT_ID=your_pinterest_account_id